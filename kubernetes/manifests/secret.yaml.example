# ============================================================================
# Modèle du Secret "app-secrets" — NE PAS remplir ce fichier dans Git
# ============================================================================
# Les secrets ne sont plus versionnés. Vault (secret/devsecops) est la source
# de vérité ; le Secret Kubernetes est créé par :
#
#   .\scripts\seed-vault.ps1          # amorce Vault (une fois par démarrage)
#   .\scripts\sync-k8s-secrets.ps1    # Vault -> Secret Kubernetes
#
# Clés attendues par les Deployments :
#   DB_USER, DB_PASSWORD, POSTGRES_PASSWORD   (PostgreSQL + CronJob de backup)
#   JWT_SECRET                                (signature des jetons de l'API)
#   ADMIN_USERNAME, ADMIN_PASSWORD            (compte de connexion à l'application)
#
# Extension ".example" : Argo CD ignore ce fichier (il ne lit que .yaml/.yml/.json).
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: devsecops-platform
type: Opaque
stringData:
  DB_USER: "<from-vault>"
  DB_PASSWORD: "<from-vault>"
  POSTGRES_PASSWORD: "<from-vault>"
  JWT_SECRET: "<from-vault>"
  ADMIN_USERNAME: "<from-vault>"
  ADMIN_PASSWORD: "<from-vault>"
